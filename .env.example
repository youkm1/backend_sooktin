# docker-compose.yml 이 읽는 환경변수 템플릿.
#
# EC2 에서 최초 1회만 아래처럼 실제 파일을 만든다. 이 파일(.env)은 .gitignore 에 있어
# 깃에 올라가지 않고, 배포 워크플로도 복사하지 않으므로 배포해도 덮어써지지 않는다.
#
#   cd ~/app
#   cp .env.example .env
#   vi .env          # 실제 값으로 채운다
#
# 주의: 이 값이 비어 있으면 docker compose 가 기동을 거부한다.

# 그라파나 관리자 비밀번호.
# 예전 값(sooktin2024!)은 깃 히스토리에 남아 있으므로 반드시 새 값으로 바꿀 것.
GRAFANA_ADMIN_PASSWORD=
