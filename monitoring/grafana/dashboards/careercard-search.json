{
  "uid": "sooktin-search",
  "title": "커리어카드 검색",
  "tags": ["sooktin", "search", "cache"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "검색 캐시 히트율",
      "description": "누적 카운터를 그대로 나누면 기동 이후 전체 평균이라 변화가 안 보인다. rate() 로 최근 1분 구간만 본다. result 라벨에는 hit/miss 외에 pending 도 있어 분모를 hit|miss 로 한정한다.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sooktin-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "sooktin-prometheus" },
          "expr": "sum(rate(cache_gets_total{cache=\"careerCardSearch\",result=\"hit\"}[1m])) / sum(rate(cache_gets_total{cache=\"careerCardSearch\",result=~\"hit|miss\"}[1m]))",
          "legendFormat": "hit rate"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "캐시 히트 / 미스 처리량",
      "description": "히트율 숫자 하나보다 모양이 더 많은 것을 말해준다. 캐시를 비우고 부하를 걸면 미스가 먼저 치솟았다가 히트로 넘어가는 곡선이 보인다.",
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sooktin-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "sooktin-prometheus" },
          "expr": "sum(rate(cache_gets_total{cache=\"careerCardSearch\",result=~\"hit|miss\"}[1m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "검색 응답시간 p50 / p95 / p99",
      "description": "캐시가 켜져 있으면 히트와 미스가 갈려 p50 과 p95 가 크게 벌어진다. 그 간격이 곧 캐시가 가려주고 있는 쿼리 비용이다.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "sooktin-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "sooktin-prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{uri=\"/career-cards/search\"}[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "sooktin-prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=\"/career-cards/search\"}[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "sooktin-prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri=\"/career-cards/search\"}[1m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HikariCP 커넥션",
      "description": "검색이 커넥션을 오래 붙잡으면 pending 이 쌓인다. pending 이 올라가는 순간이 곧 로그인 같은 다른 요청까지 connection-timeout 으로 실패하기 시작하는 지점이다.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "sooktin-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "sooktin-prometheus" },
          "expr": "hikaricp_connections_active",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "sooktin-prometheus" },
          "expr": "hikaricp_connections_pending",
          "legendFormat": "pending (대기)"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "sooktin-prometheus" },
          "expr": "hikaricp_connections_max",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "pending (대기)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "검색 처리량 / 에러",
      "description": "status 별로 나눠 본다. 부하 중 5xx 가 생기면 여기서 먼저 보인다.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "sooktin-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "sooktin-prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/career-cards/search\"}[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      }
    }
  ]
}
